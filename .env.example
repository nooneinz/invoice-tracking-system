# انسخ هذا الملف إلى backend/.env (للتشغيل المحلي) أو .env في جذر المشروع (لـ Docker)
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=ضع-كلمة-مرور-قوية
JWT_SECRET=ضع-نصاً-عشوائياً-طويلاً
# اختياري: يعيد صياغة نص التذكيرات ويفهم الأسئلة الحرة للوكلاء
ANTHROPIC_API_KEY=
# اختياري: لإرسال البريد فعلياً (وإلا تبقى الرسائل مسودات)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# اختياري: سرّ توقيع webhook بوابة الدفع (HMAC-SHA256)
WEBHOOK_SECRET=
